# Copy this file to .env and fill in your keys. .env is never committed.
#
# NVIDIA NIM is the default and the only required provider.
# Get a key at https://build.nvidia.com and paste it here.
NVIDIA_API_KEY=your_nvidia_api_key_here

# Optional. Adds Claude models to the sidebar and turns on picture rendering.
# Mesh API is an OpenAI-compatible gateway. Get a key at https://meshapi.ai
# Leave blank for NVIDIA-only use, which is fully supported: every feature except
# raster image generation works without it.
MESH_API_KEY=

# Optional. Which model the sidebar starts on. An unrecognised value is ignored and
# the first allowlisted NVIDIA model is used instead. A Mesh model here is ignored
# unless MESH_API_KEY is also set, so the app never defaults to something it cannot
# call.
#
#   NVIDIA, no Mesh key needed:
#     nvidia/nemotron-3-super-120b-a12b      cleanest structured output
#     meta/llama-3.2-11b-vision-instruct     fastest
#     nvidia/nemotron-3.5-lightning-30b-a3b
#
#   Mesh, needs MESH_API_KEY:
#     anthropic/claude-opus-5                best writing
#     anthropic/claude-sonnet-5              fast and strong
#     anthropic/claude-haiku-4.5             cheapest
#
# Providers retire models on a schedule. The sidebar has a button that re-checks
# the allowlist against the live catalogue.
DEFAULT_MODEL=anthropic/claude-opus-5

# Optional. Which image model renders the picture package. Needs MESH_API_KEY.
# Defaults to black-forest-labs/flux.1-schnell, which is fast and cheap.
MESH_IMAGE_MODEL=
