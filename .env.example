# NVIDIA NIM is the default and the only required provider.
# Get a key at https://build.nvidia.com and paste it here.
NVIDIA_API_KEY=your_nvidia_api_key_here

# Optional. Selects which allowlisted NVIDIA model is the default in the sidebar.
# An unrecognised value is ignored and the first allowlisted model is used instead.
#   nvidia/nemotron-3-super-120b-a12b      (default, cleanest structured output)
#   meta/llama-3.2-11b-vision-instruct     (fastest)
#   nvidia/nemotron-3.5-lightning-30b-a3b
# NVIDIA retires models on a schedule. The sidebar has a button that re-checks the
# allowlist against the live catalogue.
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# Optional. Adds extra text models to the sidebar. Leave both blank for NVIDIA-only
# use, which is fully supported: every feature except raster image generation works.
OPENROUTER_API_KEY=

# Optional. An image-capable model on OpenRouter, for rendering the picture package.
# Without it the picture package returns its art-direction prompt, which is still a
# deliverable. Example: google/gemini-2.5-flash-image-preview
OPENROUTER_IMAGE_MODEL=
