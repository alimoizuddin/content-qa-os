# Binary files must never have line endings rewritten, or they are corrupted
# on checkout. summary.pdf was being treated as text.
*.pdf binary
*.docx binary
*.png binary
*.jpg binary
*.ttf binary
*.zip binary

# Launchers need exact line endings: a batch file with Unix endings can break its
# error handling, and a shell script with Windows endings will not run at all.
*.bat text eol=crlf
*.sh text eol=lf
